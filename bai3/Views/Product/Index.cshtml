@model IEnumerable<bai3.Models.ProductViewModel>

@{
    ViewData["Title"] = "Index";
    var searchString = ViewData["SearchString"] as string;
    var sortBy = ViewData["SortBy"] as string ?? "name";
    var descending = ViewData["Descending"] is bool value && value;
    var page = ViewData["Page"] is int currentPage ? currentPage : 1;
    var totalPages = ViewData["TotalPages"] is int pageCount ? pageCount : 1;
}

<h1>Index</h1>

<div class="d-flex justify-content-between mb-3">
    <a asp-action="Create" class="btn btn-primary">Create New</a>

    <form asp-action="Index" method="get" class="d-flex">
        <input type="text"
               name="searchString"
               value="@searchString"
               class="form-control me-2"
               placeholder="Search by product name" />
        <input type="hidden" name="sortBy" value="@sortBy" />
        <input type="hidden" name="descending" value="@descending" />
        <button type="submit" class="btn btn-outline-secondary">Search</button>
    </form>
</div>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.ActionLink("Id", "Index", new
                {
                    searchString,
                                sortBy = "id",
                                descending = sortBy == "id" && !descending,
                                page
                                })
            </th>
            <th>
                @Html.ActionLink("Name", "Index", new
                                {
                    searchString,
                                sortBy = "name",
                                descending = sortBy == "name" && !descending,
                                page
                                })
            </th>
            <th>
                @Html.ActionLink("Price", "Index", new
                                {
                    searchString,
                                sortBy = "price",
                                descending = sortBy == "price" && !descending,
                                page
                                })
            </th>
            <th>
                @Html.ActionLink("Description", "Index", new
                                {
                    searchString,
                                sortBy = "description",
                                descending = sortBy == "description" && !descending,
                                page
                                })
            </th>
            <th>
                @Html.ActionLink("Category Id", "Index", new
                                {
                    searchString,
                                sortBy = "categoryid",
                                descending = sortBy == "categoryid" && !descending,
                                page
                                })
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Description</td>
                <td>@item.CategoryId</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Details", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Delete", "Delete", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="d-flex align-items-center gap-3">
    @if (page > 1)
    {
        @Html.ActionLink("Previous", "Index", new
        {
            searchString,
        sortBy,
        descending,
        page = page - 1
        }, new { @class = "btn btn-outline-primary" })
        }

    <span>Page @(page) of @(totalPages)</span>

    @if (page < totalPages)
    {
        @Html.ActionLink("Next", "Index", new
        {
            searchString,
        sortBy,
        descending,
        page = page + 1
        }, new { @class = "btn btn-outline-primary" })
        }
</div>